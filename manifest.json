{
  "manifest_version": 3,
  "name": "PromptShelf",
  "version": "0.1.0",
  "description": "Browse local agent prompts, preview the right agent section, and copy it to the clipboard.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PromptShelf",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["storage", "clipboardWrite"]
}
